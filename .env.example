# Copy this to .env and fill in your values. NEVER commit .env.

# ── LLM ──────────────────────────────────────────────────────
LLM_PROVIDER=openai          # openai | anthropic | groq
LLM_MODEL=gpt-4o-mini        # gpt-4o-mini | claude-haiku-4-5-20251001 | llama-3.3-70b-versatile
LLM_API_KEY=sk-...

# ── Cal.com booking ──────────────────────────────────────────
CALCOM_API_KEY=cal_live_...
CALCOM_EVENT_TYPE_ID=123456  # numeric ID from your Cal.com event type URL
CALCOM_USERNAME=himesh-pandey

# ── Corpus paths (defaults shown, relative to repo root) ─────
RESUME_PATH=corpus/resume.pdf
ABOUT_ME_PATH=corpus/about_me.md
FAISS_INDEX_PATH=corpus/faiss_index

# ── Voice stack (Phase 3) ────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPGRAM_API_KEY=...
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...      # pick a voice from ElevenLabs that sounds professional

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
